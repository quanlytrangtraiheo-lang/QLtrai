        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "farmId": { "type": "string", "maxLength": 128 },
        "farmOwnerId": { "type": "string", "maxLength": 128 },
        "sowId": { "type": "string", "maxLength": 128 },
        "sowEarTag": { "type": "string", "minLength": 1, "maxLength": 60 },
        "litterCode": { "type": "string", "minLength": 1, "maxLength": 60 },
        "parity": { "type": "number" },
        "barnName": { "type": "string", "maxLength": 100 },
        "farrowingDate": { "type": "string", "maxLength": 32 },
        "expectedWeaningDate": { "type": "string", "maxLength": 32 },
        "liveBorn": { "type": "number" },
        "currentCount": { "type": "number" },
        "mortalityCount": { "type": "number" },
        "avgWeightKg": { "type": "number" },
        "healthStatus": { "type": "string", "enum": ["healthy", "monitoring", "sick"] },
        "status": { "type": "string", "enum": ["suckling", "weaned"] },
        "weanedDate": { "type": "string", "maxLength": 32 },
        "weanedCount": { "type": "number" },
        "weanedGroupId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 800 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "farmId", "farmOwnerId", "sowId", "sowEarTag", "litterCode", "parity", "farrowingDate", "liveBorn", "currentCount", "healthStatus", "status", "createdBy", "createdAt", "updatedAt"]
    }
  },
